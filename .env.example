# Server / API Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurantpos?retryWrites=true&w=majority
JWT_SECRET=super_secure_jwt_secret_at_least_16_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super_secure_cookie_secret_at_least_16_chars
CORS_ORIGIN=https://<your-frontend-domain>.onrender.com

# Web / Frontend Configuration (Build-time)
VITE_API_BASE_URL=https://<your-api-domain>.onrender.com
VITE_SOCKET_URL=https://<your-api-domain>.onrender.com